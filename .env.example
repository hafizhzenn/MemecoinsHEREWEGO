# Birdeye Data Services — https://bds.birdeye.so (Security tab -> Generate Key)
BIRDEYE_API_KEY=your_new_birdeye_key

# Optional: Telegram alerts. Leave blank to print alerts to console instead.
# Create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Helius — https://dashboard.helius.dev (free tier, no card)
HELIUS_API_KEY=your_new_helius_key

# Paper trading config
BANKROLL_USD=1000
SCAN_INTERVAL_SECONDS=300
SMARTMONEY_INTERVAL_SECONDS=1800